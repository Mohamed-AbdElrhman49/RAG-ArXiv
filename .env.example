# انسخ الملف ده لـ .env وحط مفتاحك. ما ترفعش .env على GitHub (موجود في .gitignore)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_REASONING_EFFORT=default     # اختياري، القيم المسموحة بتختلف من موديل لموديل
MAX_NEW_TOKENS=1500

TOP_K=3
N_CANDIDATES=30
USE_RERANKER=true

# SERVICE_API_KEY=change-me         # لو اتحط، الـ /query بيطلب header: X-API-Key
